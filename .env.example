# انسخ هذا الملف إلى ‎.env واملأ القيم الحقيقية

# رابط قاعدة بيانات Turso (libSQL)
TURSO_DATABASE_URL=libsql://your-database.turso.io
# توكن قاعدة البيانات من لوحة Turso
TURSO_AUTH_TOKEN=your-turso-auth-token

# مفتاح API من kie.ai (https://kie.ai/api-key)
KIE_API_KEY=your-kie-api-key

# (اختياري) أسماء النماذج — القيم الافتراضية مدمجة في الكود
KIE_IMAGE_MODEL=gpt-image-2-6/flare-text-to-image
KIE_VIDEO_MODEL=grok-imagine-video-1-5-preview
KIE_CHAT_MODEL=kimi-k3-1-pro

# (اختياري) لربط المحادثة بمفتاح ChatGPT / OpenAI الخاص بك بدلًا من kie.ai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# (اختياري) حماية مسار الأوتوبايلوت /api/autopilot/run بتوكن سرّي.
# اتركه فارغًا ليكون النشر التلقائي مفتوحًا (أسهل مع ChatGPT).
# إذا ضبطت CRON_SECRET فسيرسله Vercel Cron تلقائيًا في ترويسة Authorization.
# AUTOPILOT_TOKEN=my-secret-token
# CRON_SECRET=vercel-cron-secret

# (اختياري) مواضيع النشر التلقائي مخصصة — مفصولة بعلامة |
# AUTOPILOT_TOPICS=وصف فيديو إنجليزي أول|وصف فيديو إنجليزي ثانٍ
